<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Disabled state -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="@color/brutal_black" />
            <corners android:radius="0dp" />
            <solid android:color="@color/brutal_white" />
        </shape>
    </item>

    <!-- Pressed state: fill flips to black -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="@color/brutal_black" />
            <corners android:radius="0dp" />
            <solid android:color="@color/brutal_black" />
        </shape>
    </item>

    <!-- Default / enabled state -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="@color/brutal_black" />
            <corners android:radius="0dp" />
            <solid android:color="@color/brutal_yellow" />
        </shape>
    </item>

</selector>
