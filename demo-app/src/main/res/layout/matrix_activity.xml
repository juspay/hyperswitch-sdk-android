<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/matrixHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Headless matrix"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/runAllButton"
                style="@style/HsButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Run all" />

            <Button
                android:id="@+id/resetButton"
                style="@style/HsButtonOutline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reset" />

            <Button
                android:id="@+id/copyLogButton"
                style="@style/HsButtonOutline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Copy log" />
        </LinearLayout>

        <Button
            android:id="@+id/continueButton"
            style="@style/HsButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue"
            android:visibility="gone" />

        <TextView
            android:id="@+id/gateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="italic"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/scenarioList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <io.hyperswitch.view.PaymentElement
            android:id="@+id/container1"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="8dp" />

        <io.hyperswitch.view.PaymentElement
            android:id="@+id/container2"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="8dp" />

        <io.hyperswitch.view.PaymentElement
            android:id="@+id/container3"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="8dp" />

        <io.hyperswitch.view.CVCWidget
            android:id="@+id/cvcContainer"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp" />

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="8dp"
            android:background="#111111">

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:textColor="#DDDDDD"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
