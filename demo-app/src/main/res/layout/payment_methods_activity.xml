<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brutal_yellow"
    android:fitsSystemWindows="true"
    tools:context=".PaymentMethodsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- ── Title ────────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:text="@string/title_payment_methods_demo"
            android:textAllCaps="true"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/brutal_black" />

        <!-- ── Status ───────────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:minHeight="40dp"
            android:textColor="@color/brutal_black"
            android:textStyle="bold"
            android:textSize="14sp" />

        <Button
            android:id="@+id/reloadInstanceButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/brutal_button"
            android:text="@string/btn_reload_instance"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textColor="@color/brutal_black"
            android:textSize="14sp" />

        <!-- ── Section: Card Form ──────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/section_card_form"
            android:textAllCaps="true"
            android:textSize="13sp"
            android:letterSpacing="0.1"
            android:textColor="@color/brutal_black" />

        <!--
            No app:field* attrs here — every FieldStyles/FieldOptions slot the brutal theme
            uses is set programmatically in PaymentMethodsActivity.kt via
            `BaseRNViewInput.setOptions(styles, options, placeholder)`. Only plain Android
            layout (id/size/margins) stays in XML; android:layout_height sizes the *native*
            widget only — it has no bearing on the JS-rendered input box's own height (that's
            whatever `styles.container.height` says, resolved on the RN side).
        -->
        <io.hyperswitch.paymentmethods.widget.CardHolderInputField
            android:id="@+id/cardHolderInput"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp" />

        <io.hyperswitch.paymentmethods.widget.CardNumberInputField
            android:id="@+id/cardNumberInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp" />

        <!-- Expiry and CVC side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <io.hyperswitch.paymentmethods.widget.CardExpiryInputField
                android:id="@+id/cardExpiryInput"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp" />

            <io.hyperswitch.paymentmethods.widget.CardCVCInputField
                android:id="@+id/cardCVCInput"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <Button
            android:id="@+id/tokeniseButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/brutal_button"
            android:text="@string/btn_tokenise"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textColor="@color/brutal_black"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
