<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page"
    android:fitsSystemWindows="true"
    tools:context=".PaymentMethodsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- ── Title ────────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:text="@string/title_payment_methods_demo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- ── Status ───────────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:minHeight="40dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/reloadInstanceButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_button_outline"
            android:text="@string/btn_reload_instance"
            android:textAllCaps="false"
            android:textColor="@color/hs_blue_outline"
            android:textSize="14sp" />

        <!-- ── Section: Card Form ──────────────────────────────────────── -->
        <TextView
            style="@style/HsSectionLabel"
            android:text="@string/section_card_form" />

        <io.hyperswitch.paymentmethods.widget.CardHolderInputField
            android:id="@+id/cardHolderInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_button_outline" />

        <io.hyperswitch.paymentmethods.widget.CardNumberInputField
            android:id="@+id/cardNumberInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_button_outline" />

        <!-- Expiry and CVC side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <io.hyperswitch.paymentmethods.widget.CardExpiryInputField
                android:id="@+id/cardExpiryInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/rounded_button_outline" />

            <io.hyperswitch.paymentmethods.widget.CardCVCInputField
                android:id="@+id/cardCVCInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/rounded_button_outline" />

        </LinearLayout>

        <Button
            android:id="@+id/tokeniseButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_button_outline"
            android:text="@string/btn_tokenise"
            android:textAllCaps="false"
            android:textColor="@color/hs_blue_outline"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
