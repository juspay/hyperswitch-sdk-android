<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brutal_yellow"
    android:fitsSystemWindows="true"
    tools:context=".PaymentMethodsViewActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- ── Title ────────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:text="@string/title_payment_methods_view"
            android:textAllCaps="true"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/brutal_black" />

        <!-- ── Status ───────────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:minHeight="40dp"
            android:textColor="@color/brutal_black"
            android:textStyle="bold"
            android:textSize="14sp" />

        <!-- ── Section: Card Form ──────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/section_card_form"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.1"
            android:textColor="@color/brutal_black" />

        <!--
            This CardForm was created in PaymentMethodsInitActivity — none of these fields'
            styling depends on that; every FieldStyles/FieldOptions attribute below works the
            same regardless of which activity actually calls cardForm.bind(...).
        -->
        <io.hyperswitch.paymentmethods.widget.CardHolderInputField
            android:id="@+id/cardHolderInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            app:fieldRootBackgroundColor="@color/brutal_yellow"
            app:fieldRootPadding="0dp"
            app:fieldContainerBackgroundColor="@color/brutal_white"
            app:fieldContainerBorderColor="@color/brutal_black"
            app:fieldContainerBorderRadius="0dp"
            app:fieldContainerBorderWidth="3dp"
            app:fieldContainerPadding="14dp"
            app:fieldInputFontSize="17sp"
            app:fieldInputTextColor="@color/brutal_black"
            app:fieldPlaceholderTextColor="@color/brutal_black"
            app:fieldPlaceholderFontSize="17sp"
            app:fieldLabelTextColor="@color/brutal_black"
            app:fieldLabelFontSize="12sp"
            app:fieldErrorTextColor="@color/brutal_red"
            app:fieldErrorFontSize="12sp"
            app:fieldPlaceholder="Cardholder name"
            app:fieldLabel="Cardholder name"
            app:fieldLabelBehavior="above"
            app:fieldErrorDisplay="colorOnly"
            app:fieldUnstyled="false"
            app:fieldAccessibilityLabel="Cardholder name input"
            app:fieldAccessibilityHint="Enter the name printed on the card" />

        <io.hyperswitch.paymentmethods.widget.CardNumberInputField
            android:id="@+id/cardNumberInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            app:fieldRootBackgroundColor="@color/brutal_yellow"
            app:fieldRootPadding="0dp"
            app:fieldContainerBackgroundColor="@color/brutal_white"
            app:fieldContainerBorderColor="@color/brutal_black"
            app:fieldContainerBorderRadius="0dp"
            app:fieldContainerBorderWidth="3dp"
            app:fieldContainerPadding="14dp"
            app:fieldInputFontSize="17sp"
            app:fieldInputTextColor="@color/brutal_black"
            app:fieldPlaceholderTextColor="@color/brutal_black"
            app:fieldPlaceholderFontSize="17sp"
            app:fieldLabelTextColor="@color/brutal_black"
            app:fieldLabelFontSize="12sp"
            app:fieldErrorTextColor="@color/brutal_red"
            app:fieldErrorFontSize="12sp"
            app:fieldAccessoryBackgroundColor="@color/brutal_white"
            app:fieldAccessoryBorderRadius="0dp"
            app:fieldAccessoryBorderWidth="0dp"
            app:fieldAccessoryPadding="2dp"
            app:fieldPlaceholder="Card number"
            app:fieldLabel="Card number"
            app:fieldLabelBehavior="floating"
            app:fieldErrorDisplay="inline"
            app:fieldUnstyled="false"
            app:fieldAccessibilityLabel="Card number input"
            app:fieldAccessibilityHint="Enter your 16 digit card number"
            app:fieldCardBrandIcon="standard" />

        <!-- Expiry and CVC side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <io.hyperswitch.paymentmethods.widget.CardExpiryInputField
                android:id="@+id/cardExpiryInput"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:fieldRootBackgroundColor="@color/brutal_yellow"
                app:fieldRootPadding="0dp"
                app:fieldContainerBackgroundColor="@color/brutal_white"
                app:fieldContainerBorderColor="@color/brutal_black"
                app:fieldContainerBorderRadius="0dp"
                app:fieldContainerBorderWidth="3dp"
                app:fieldContainerPadding="12dp"
                app:fieldInputFontSize="15sp"
                app:fieldInputTextColor="@color/brutal_black"
                app:fieldPlaceholderTextColor="@color/brutal_black"
                app:fieldPlaceholderFontSize="15sp"
                app:fieldLabelTextColor="@color/brutal_black"
                app:fieldLabelFontSize="11sp"
                app:fieldErrorTextColor="@color/brutal_red"
                app:fieldErrorFontSize="11sp"
                app:fieldPlaceholder="MM / YY"
                app:fieldLabel="Expiry"
                app:fieldLabelBehavior="never"
                app:fieldErrorDisplay="none"
                app:fieldUnstyled="false"
                app:fieldAccessibilityLabel="Expiry date input"
                app:fieldAccessibilityHint="Enter the card expiry date" />

            <io.hyperswitch.paymentmethods.widget.CardCVCInputField
                android:id="@+id/cardCVCInput"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:fieldRootBackgroundColor="@color/brutal_yellow"
                app:fieldRootPadding="0dp"
                app:fieldContainerBackgroundColor="@color/brutal_white"
                app:fieldContainerBorderColor="@color/brutal_black"
                app:fieldContainerBorderRadius="0dp"
                app:fieldContainerBorderWidth="3dp"
                app:fieldContainerPadding="12dp"
                app:fieldInputFontSize="15sp"
                app:fieldInputTextColor="@color/brutal_black"
                app:fieldPlaceholderTextColor="@color/brutal_black"
                app:fieldPlaceholderFontSize="15sp"
                app:fieldLabelTextColor="@color/brutal_black"
                app:fieldLabelFontSize="11sp"
                app:fieldErrorTextColor="@color/brutal_red"
                app:fieldErrorFontSize="11sp"
                app:fieldAccessoryBackgroundColor="@color/brutal_white"
                app:fieldAccessoryBorderRadius="0dp"
                app:fieldAccessoryBorderWidth="0dp"
                app:fieldAccessoryPadding="2dp"
                app:fieldPlaceholder="CVC"
                app:fieldLabel="CVC"
                app:fieldLabelBehavior="never"
                app:fieldErrorDisplay="none"
                app:fieldUnstyled="false"
                app:fieldAccessibilityLabel="CVC input"
                app:fieldAccessibilityHint="Enter the 3 digit security code"
                app:fieldCvcIcon="defaultIcon" />

        </LinearLayout>

        <Button
            android:id="@+id/tokeniseButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/brutal_button"
            android:text="@string/btn_tokenise"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textColor="@color/brutal_black"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
